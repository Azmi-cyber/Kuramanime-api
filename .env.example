# ============================================================
# Kuramanime Scraper API - Environment Variables
# Semua variable dibaca HANYA lewat lib/config.js
# ============================================================

# Base target scrape (tanpa trailing slash). Ganti di sini kalau domain pindah.
BASE_URL=https://v20.kuramanime.ing

# Timeout axios per request (ms). Default 8000, MAKS 9000 (limit Vercel Hobby = 10 detik).
REQUEST_TIMEOUT_MS=8000

# Retry maksimal (integer) dan jeda antar retry (ms).
MAX_RETRY=2
RETRY_DELAY_MS=500

# TTL cache in-memory (ms). Default 300000 = 5 menit.
CACHE_TTL_MS=300000

# On/off cache in-memory (true/false).
ENABLE_CACHE=true

# User-Agent request ke target (bisa dioverride).
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Referer request ke target. Kosong = otomatis BASE_URL + "/".
REFERER=https://v20.kuramanime.ing/

# API key. Kosong = auth dimatikan. Kalau diisi, semua request WAJIB kirim header x-api-key.
API_KEY=

# ---- Opsional (punya default aman) ----
# Maks halaman tambahan (pagination) daftar episode yang di-fetch di /api/anime/:id/:slug. 0 = nonaktif.
MAX_EPISODE_PAGES=10

# Total budget waktu per request handler (ms) termasuk retry. Default 9000, maks 9500.
TOTAL_BUDGET_MS=9000
